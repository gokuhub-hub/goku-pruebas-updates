-- 3. SNAP CAR MODULE (Completado y funcional)
local SnapCar = (function()
	local Player = LocalPlayer
	local SnapCarState = {
		Enabled = false, Exiting = false, Vehicle = nil, Root = nil, Seat = nil,
		DesiredRootY = nil, RootToBottom = nil, Depth = 13, SnapGroundY = nil,
		OriginalProps = setmetatable({}, {__mode = "k"}), AvatarDisc = nil
	}

	local function GetVehicle()
		local char = Player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local seat = hum and hum.SeatPart
		if not seat or not seat:IsA("VehicleSeat") then return nil, nil, nil end
		local vehicle = seat:FindFirstAncestorOfClass("Model")
		if not vehicle then return nil, nil, nil end
		local root = vehicle.PrimaryPart or seat.AssemblyRootPart or seat
		if root then root = root.AssemblyRootPart or root end
		return vehicle, root, seat
	end

	local function FlatLook(cf)
		local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
		if look.Magnitude <= 0.001 then return Vector3.new(0, 0, -1) end
		return look.Unit
	end

	local function Upright(position, lookVector)
		local flat = Vector3.new(lookVector.X, 0, lookVector.Z)
		if flat.Magnitude <= 0.001 then flat = Vector3.new(0, 0, -1) end
		return CFrame.lookAt(position, position + flat.Unit, Vector3.yAxis)
	end

	local function SavePart(part, allowTouch)
		if not part or not part:IsA("BasePart") then return end
		if SnapCarState.OriginalProps[part] == nil then
			SnapCarState.OriginalProps[part] = { CanCollide = part.CanCollide, CanTouch = part.CanTouch, CanQuery = part.CanQuery }
		end
		pcall(function() part.CanCollide = false; part.CanTouch = allowTouch == true; part.CanQuery = false end)
	end

	local function PhaseVehicle(vehicle)
		if vehicle then for _, obj in ipairs(vehicle:GetDescendants()) do if obj:IsA("BasePart") then SavePart(obj, true) end end end
		local char = Player.Character
		if char then for _, obj in ipairs(char:GetDescendants()) do if obj:IsA("BasePart") then SavePart(obj, false) end end end
	end

	local function FullGhost(vehicle)
		if not vehicle then return end
		for _, obj in ipairs(vehicle:GetDescendants()) do
			if obj:IsA("BasePart") then
				SavePart(obj, false)
				pcall(function() obj.CanCollide = false; obj.CanTouch = false; obj.CanQuery = false end)
			end
		end
		local char = Player.Character
		if char then for _, obj in ipairs(char:GetDescendants()) do if obj:IsA("BasePart") then SavePart(obj, false); pcall(function() obj.CanCollide = false; obj.CanTouch = false; obj.CanQuery = false end) end end end
	end

	local function ZeroMotion(vehicle, root)
		if root and root.Parent then pcall(function() root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero end) end
		if vehicle then for _, obj in ipairs(vehicle:GetDescendants()) do if obj:IsA("BasePart") then pcall(function() obj.AssemblyLinearVelocity = Vector3.zero; obj.AssemblyAngularVelocity = Vector3.zero end) end end end
	end

	local function RestoreAll()
		for part, props in pairs(SnapCarState.OriginalProps) do
			if part and part.Parent and props then pcall(function() part.CanCollide = props.CanCollide; part.CanTouch = props.CanTouch; part.CanQuery = props.CanQuery end) end
			SnapCarState.OriginalProps[part] = nil
		end
	end

	local function GroundY(vehicle, root)
		if not root then return nil end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.IgnoreWater = true
		local ignore = {vehicle}
		if Player.Character then table.insert(ignore, Player.Character) end
		params.FilterDescendantsInstances = ignore
		local result = workspace:Raycast(root.Position + Vector3.new(0, 8, 0), Vector3.new(0, -300, 0), params)
		return result and result.Position.Y or (root.Position.Y - 3)
	end

	local function DestroyAvatar()
		if SnapCarState.AvatarDisc then pcall(function() SnapCarState.AvatarDisc:Destroy() end) end
		SnapCarState.AvatarDisc = nil
	end

	local function CreateAvatar(vehicle, root)
		DestroyAvatar()
		if not vehicle or not root then return end
		local disc = Instance.new("Part")
		disc.Name = "CHINO_SnapCarPurpleDisc"
		disc.Size = Vector3.new(24, 0.06, 24)
		disc.Transparency = 1
		disc.Anchored = false
		disc.Massless = true
		disc.CanCollide = false
		disc.CanTouch = false
		disc.CanQuery = false
		disc.CastShadow = false
		local offsetY = (SnapCarState.RootToBottom or 2.5) + 0.22
		disc.CFrame = root.CFrame * CFrame.new(0, -offsetY, 0)
		disc.Parent = workspace
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = disc
		weld.Parent = disc
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Top
		gui.AlwaysOnTop = false
		gui.LightInfluence = 0
		gui.PixelsPerStud = 55
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.Parent = disc
		local holder = Instance.new("Frame")
		holder.Size = UDim2.fromScale(1, 1)
		holder.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		holder.BackgroundTransparency = 1
		holder.BorderSizePixel = 0
		holder.ClipsDescendants = true
		holder.Parent = gui
		Instance.new("UICorner", holder).CornerRadius = UDim.new(1, 0)
		local imageLabel = Instance.new("ImageLabel")
		imageLabel.Size = UDim2.fromScale(1, 1)
		imageLabel.BackgroundTransparency = 1
		imageLabel.Image = "rbxassetid://105275560374583"
		imageLabel.ScaleType = Enum.ScaleType.Crop
		imageLabel.Parent = holder
		Instance.new("UICorner", imageLabel).CornerRadius = UDim.new(1, 0)
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 3
		stroke.Transparency = 0.12
		stroke.Color = Color3.fromRGB(255, 255, 255)
		stroke.Parent = holder
		SnapCarState.AvatarDisc = disc
	end

	function SnapCarState.Set(state)
		state = state == true
		if SnapCarState.Exiting then return false end

		if state then
			if SnapCarState.Enabled then return true end
			local vehicle, root, seat = GetVehicle()
			if not vehicle or not root or not seat then return false end
			local groundY = GroundY(vehicle, root)
			if not groundY then return false end

			SnapCarState.SnapGroundY = groundY
			local boxCF, boxSize = vehicle:GetBoundingBox()
			local bottomY = boxCF.Position.Y - (boxSize.Y * 0.5)
			SnapCarState.RootToBottom = root.Position.Y - bottomY
			SnapCarState.DesiredRootY = groundY - SnapCarState.Depth + SnapCarState.RootToBottom + 0.35

			SnapCarState.Vehicle = vehicle
			SnapCarState.Root = root
			SnapCarState.Seat = seat

			PhaseVehicle(vehicle)
			local upright = Upright(Vector3.new(root.Position.X, SnapCarState.DesiredRootY, root.Position.Z), FlatLook(root.CFrame))
			local rootToPivot = root.CFrame:ToObjectSpace(vehicle:GetPivot())
			pcall(function()
				vehicle:PivotTo(upright * rootToPivot)
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end)

			SnapCarState.Enabled = true
			CreateAvatar(vehicle, root)
			return true
		end

		if not SnapCarState.Enabled then return true end
		SnapCarState.Exiting = true
		SnapCarState.Enabled = false
		DestroyAvatar()

		local vehicle, root = SnapCarState.Vehicle, SnapCarState.Root
		if vehicle and vehicle.Parent and root and root.Parent then
			FullGhost(vehicle)
			ZeroMotion(vehicle, root)
			local surfaceY = SnapCarState.SnapGroundY or root.Position.Y
			local boxCF, boxSize = vehicle:GetBoundingBox()
			local bottomY = boxCF.Position.Y - (boxSize.Y * 0.5)
			local rootToBottom = root.Position.Y - bottomY
			local targetRootY = surfaceY + 1.65 + rootToBottom
			local flatLook = FlatLook(root.CFrame)
			local startRoot = Upright(root.Position, flatLook)
			local rootToPivot = root.CFrame:ToObjectSpace(vehicle:GetPivot())
			pcall(function()
				vehicle:PivotTo(startRoot * rootToPivot)
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end)
			task.wait(0.35)
			RestoreAll()
		end
		SnapCarState.Exiting = false
		return true
	end

	RunService.Heartbeat:Connect(function()
		if SnapCarState.Enabled and not SnapCarState.Exiting then
			local vehicle, root = SnapCarState.Vehicle, SnapCarState.Root
			if vehicle and root and root.Parent then
				local currentY = root.Position.Y
				if math.abs(currentY - SnapCarState.DesiredRootY) > 0.5 then
					local flatLook = FlatLook(root.CFrame)
					local upright = Upright(Vector3.new(root.Position.X, SnapCarState.DesiredRootY, root.Position.Z), flatLook)
					local rootToPivot = root.CFrame:ToObjectSpace(vehicle:GetPivot())
					pcall(function()
						vehicle:PivotTo(upright * rootToPivot)
						root.AssemblyLinearVelocity = Vector3.zero
						root.AssemblyAngularVelocity = Vector3.zero
					end)
				end
			end
		end
	end)

	return SnapCarState
end)()

-- 4. MOD CAR MODULE
local ModCar = (function()
	local Player = LocalPlayer
	local ModCarState = {
		Enabled = false, CurrentDriveSpeed = 0, Vehicle = nil, Root = nil, Seat = nil,
		WheelVehicle = nil, WheelAngle = 0, WheelMotors = setmetatable({}, {__mode = "k"}),
		NativeSafeMax = nil, AdaptiveMax = nil, LastObservedPosition = nil,
		LastAppliedDirection = nil, LastExpectedSpeed = 0, StabilityStrikes = 0,
		ForwardMaxSpeed = 90, ReverseMaxSpeed = 90, Acceleration = 200,
		Braking = 200, DirectionRate = 200, SteerPower = 200,
	}

	local function GetVehicle()
		local char = Player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local seat = hum and hum.SeatPart
		if not seat or not seat:IsA("VehicleSeat") then return nil, nil, nil end
		local vehicle = seat:FindFirstAncestorOfClass("Model")
		if not vehicle then return nil, nil, nil end
		local root = vehicle.PrimaryPart or seat.AssemblyRootPart or seat
		if root then root = root.AssemblyRootPart or root end
		return vehicle, root, seat
	end

	local function FlatLook(cf)
		local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
		if look.Magnitude < 0.001 then return Vector3.new(0, 0, -1) end
		return look.Unit
	end

	local function UprightAt(position, look)
		return CFrame.lookAt(position, position + look, Vector3.yAxis)
	end

	local function MoveTowards(current, target, maxDelta)
		if current < target then return math.min(current + maxDelta, target)
		elseif current > target then return math.max(current - maxDelta, target) end
		return target
	end

	local function GetSafeVehicleMax(vehicle, seat)
		local native = nil
		for _, owner in ipairs({vehicle, seat}) do
			for _, name in ipairs({"TopSpeed", "MaxSpeed", "max_speed", "maxSpeed", "VehicleSpeed"}) do
				local value = tonumber(owner:GetAttribute(name))
				if value and value >= 8 and value <= 350 then native = math.max(native or 0, value) end
			end
		end
		if not native then
			pcall(function()
				local value = tonumber(seat.MaxSpeed)
				if value and value >= 8 and value <= 350 and math.abs(value - 25) > 0.5 then native = value end
			end)
		end
		return native and math.clamp(native * 1.8, 40, 200) or 140
	end

	local function RestoreWheelVisuals()
		for motor, original in pairs(ModCarState.WheelMotors) do
			if motor and motor.Parent and original then pcall(function() motor.Transform = original end) end
			ModCarState.WheelMotors[motor] = nil
		end
		ModCarState.WheelVehicle = nil
		ModCarState.WheelAngle = 0
	end

	local function ScanWheelMotors(vehicle)
		if ModCarState.WheelVehicle == vehicle then return end
		RestoreWheelVisuals()
		ModCarState.WheelVehicle = vehicle
		for _, obj in ipairs(vehicle:GetDescendants()) do
			if obj:IsA("Motor6D") then
				local n0, n1, n2 = obj.Name:lower(), obj.Part0 and obj.Part0.Name:lower() or "", obj.Part1 and obj.Part1.Name:lower() or ""
				local function wheelName(n) return n:find("wheel", 1, true) or n:find("tire", 1, true) or n:find("tyre", 1, true) or n:find("rim", 1, true) end
				if wheelName(n0) or wheelName(n1) or wheelName(n2) then ModCarState.WheelMotors[obj] = obj.Transform end
			end
		end
	end

	local function UpdateWheelVisuals(vehicle, dt, driveSpeed, throttle)
		ScanWheelMotors(vehicle)
		if next(ModCarState.WheelMotors) == nil then return end
		local visualSpeed = math.abs(driveSpeed or 0)
		if math.abs(throttle or 0) <= 0.05 and visualSpeed < 1 then visualSpeed = 8 else visualSpeed = math.max(visualSpeed, 12) end
		ModCarState.WheelAngle = (ModCarState.WheelAngle + visualSpeed * math.max(dt, 1/240) * 0.16) % (math.pi * 2)
		for motor, original in pairs(ModCarState.WheelMotors) do
			if motor and motor.Parent and original then pcall(function() motor.Transform = original * CFrame.Angles(ModCarState.WheelAngle, 0, 0) end)
			else ModCarState.WheelMotors[motor] = nil end
		end
	end

	local function ClearState(restoreWheels)
		ModCarState.NativeSafeMax, ModCarState.AdaptiveMax, ModCarState.LastObservedPosition = nil, nil, nil
		ModCarState.LastAppliedDirection, ModCarState.LastExpectedSpeed, ModCarState.StabilityStrikes = nil, 0, 0
		ModCarState.CurrentDriveSpeed, ModCarState.Vehicle, ModCarState.Root, ModCarState.Seat = 0, nil, nil, nil
		if restoreWheels then RestoreWheelVisuals() end
	end

	RunService.Heartbeat:Connect(function(dt)
		if not ModCarState.Enabled then return end
		local vehicle, root, seat = GetVehicle()
		if not vehicle or not root or not seat then ClearState(true); return end

		if ModCarState.Vehicle ~= vehicle then
			ModCarState.CurrentDriveSpeed = 0
			ModCarState.NativeSafeMax = GetSafeVehicleMax(vehicle, seat)
			ModCarState.AdaptiveMax = ModCarState.NativeSafeMax
			ModCarState.LastObservedPosition, ModCarState.StabilityStrikes = nil, 0
		end

		ModCarState.Vehicle, ModCarState.Root, ModCarState.Seat = vehicle, root, seat
		local currentPos = root.Position
		local elapsed = math.clamp(dt, 1/240, 0.10)

		if ModCarState.LastObservedPosition and ModCarState.LastAppliedDirection and (ModCarState.LastExpectedSpeed or 0) > 25 then
			local traveled = currentPos - ModCarState.LastObservedPosition
			local actualForward = traveled:Dot(ModCarState.LastAppliedDirection)
			local expectedForward = (ModCarState.LastExpectedSpeed or 0) * elapsed
			if actualForward < -math.max(2, expectedForward * 1.2) then
				ModCarState.AdaptiveMax = math.max(28, (ModCarState.AdaptiveMax or 140) * 0.72)
				ModCarState.CurrentDriveSpeed = math.clamp(ModCarState.CurrentDriveSpeed or 0, -ModCarState.AdaptiveMax * 0.65, ModCarState.AdaptiveMax)
				ModCarState.StabilityStrikes = 0
			elseif actualForward < math.max(0.10, expectedForward * 0.24) then
				ModCarState.StabilityStrikes = (ModCarState.StabilityStrikes or 0) + 1
			else
				ModCarState.StabilityStrikes = math.max(0, (ModCarState.StabilityStrikes or 0) - 1)
			end
			if ModCarState.StabilityStrikes >= 5 then
				ModCarState.AdaptiveMax = math.max(28, (ModCarState.AdaptiveMax or 140) * 0.78)
				ModCarState.StabilityStrikes = 0
			end
		end

		local wantedMax = tonumber(ModCarState.NativeSafeMax) or GetSafeVehicleMax(vehicle, seat)
		local adaptive = tonumber(ModCarState.AdaptiveMax) or wantedMax
		ModCarState.AdaptiveMax = math.min(wantedMax, adaptive + 9 * math.clamp(dt, 0, 0.1))
		ModCarState.LastObservedPosition = currentPos

		local nativeThrottle, nativeSteer = 0, 0
		pcall(function()
			local tf, ti = tonumber(seat.ThrottleFloat) or 0, tonumber(seat.Throttle) or 0
			local sf, si = tonumber(seat.SteerFloat) or 0, tonumber(seat.Steer) or 0
			nativeThrottle = math.abs(tf) >= math.abs(ti) and tf or ti
			nativeSteer = math.abs(sf) >= math.abs(si) and sf or si
		end)
		if math.abs(nativeThrottle) < 0.05 then nativeThrottle = 0 end
		if math.abs(nativeSteer) < 0.05 then nativeSteer = 0 end

		if nativeThrottle == 0 and nativeSteer == 0 then
			pcall(function()
				local char = Player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if hum and hum.MoveDirection.Magnitude > 0.05 then
					local forward = FlatLook(root.CFrame)
					local right = Vector3.new(root.CFrame.RightVector.X, 0, root.CFrame.RightVector.Z)
					if right.Magnitude > 0.001 then right = right.Unit end
					nativeThrottle = math.clamp(hum.MoveDirection:Dot(forward), -1, 1)
					nativeSteer = math.clamp(hum.MoveDirection:Dot(right), -1, 1)
				end
			end)
		end

		local safeMax = math.clamp(tonumber(ModCarState.AdaptiveMax) or 140, 25, 200)
		local forwardMax = math.min(math.clamp(ModCarState.ForwardMaxSpeed, 1, 200), safeMax)
		local reverseMax = math.min(math.clamp(ModCarState.ReverseMaxSpeed, 1, 200), safeMax * 0.65)
		local safeAccel = math.max(24, safeMax * 1.15)
		local accelRate, brakeRate, directionRate = math.min(ModCarState.Acceleration, safeAccel), math.min(ModCarState.Braking, safeAccel * 1.35), math.min(ModCarState.DirectionRate, safeAccel)
		local steerPower = ModCarState.SteerPower

		local throttleMagnitude = math.clamp(math.abs(nativeThrottle), 0, 1)
		local targetSignedSpeed = 0
		if throttleMagnitude > 0 then
			targetSignedSpeed = (nativeThrottle < 0 and -reverseMax or forwardMax) * throttleMagnitude
		end

		local currentSpeed = ModCarState.CurrentDriveSpeed or 0
		local changingDirection = currentSpeed ~= 0 and targetSignedSpeed ~= 0 and ((currentSpeed > 0 and targetSignedSpeed < 0) or (currentSpeed < 0 and targetSignedSpeed > 0))
		local rate = targetSignedSpeed == 0 and brakeRate or (changingDirection and directionRate or accelRate)

		ModCarState.CurrentDriveSpeed = MoveTowards(currentSpeed, targetSignedSpeed, rate * math.max(dt, 1/240))

		local flat = FlatLook(root.CFrame)
		local upright = UprightAt(root.Position, flat)
		local steerMultiplier = steerPower / 100
		local turnRadians = -nativeSteer * 2.8 * steerMultiplier * math.max(throttleMagnitude, 0.42) * dt
		local lowPower = safeMax < 72
		local safeTurn = lowPower and math.clamp(turnRadians, -0.030, 0.030) or math.clamp(turnRadians, -0.055, 0.055)
		local rotatedRoot = upright * CFrame.Angles(0, safeTurn, 0)

		if not lowPower then
			local rootToPivot = root.CFrame:ToObjectSpace(vehicle:GetPivot())
			pcall(function() vehicle:PivotTo(rotatedRoot * rootToPivot) end)
		end

		local direction = lowPower and flat or rotatedRoot.LookVector
		local driveVector = direction * ModCarState.CurrentDriveSpeed
		local currentY = root.AssemblyLinearVelocity.Y
		if lowPower then currentY = math.clamp(currentY, -45, 26) end
		root.AssemblyLinearVelocity = Vector3.new(driveVector.X, currentY, driveVector.Z)

		local av = root.AssemblyAngularVelocity
		if lowPower then root.AssemblyAngularVelocity = Vector3.new(av.X, math.clamp(av.Y, -3, 3), av.Z)
		else root.AssemblyAngularVelocity = Vector3.new(0, av.Y * 0.10, 0) end

		ModCarState.LastAppliedDirection = direction * (ModCarState.CurrentDriveSpeed >= 0 and 1 or -1)
